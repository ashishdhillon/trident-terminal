# =============================================================================
# TRIDENT TERMINAL v3.0 — FULL TELEMETRY & ALERTING ENV TEMPLATE
# Copy to .env.local (local dev / Tauri) or add in Vercel Project Settings.
# =============================================================================

# --- LIVE DATA FEEDS (ALL FREE) ---
# 1. FRED API (1M–30Y US Treasury Yield Curve): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 2. EIA API v2 (Weekly US SPR & Cushing Crude Stocks): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# 3. NASA FIRMS (Near Real-Time VIIRS Thermal Anomalies): https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# 4. AISStream.io (Live Maritime Vessel WebSocket — Rust/Tauri server-side only): https://aisstream.io/
AISSTREAM_API_KEY=

# 5. UCDP Conflict API (Georeferenced Event Dataset 26.1): https://ucdp.uu.se/apidocs/
UCDP_ACCESS_TOKEN=

# --- ALERT WEBHOOKS (OPTIONAL, COOLDOWN-PROTECTED) ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- MCP SERVER TARGET ---
# Point MCP to your local server or deployed Vercel URL:
TRIDENT_API_BASE=https://trident-terminal-smoky.vercel.app
